# Copy to .env (git-ignored). NODE_ENV=production reads .env.production instead.

# --- Required -------------------------------------------------------------
# Production database name used by the original deployment: medusaone
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusaone
DATABASE_TYPE=postgres
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# Comma-separated origins allowed to call the store / admin APIs
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
# The Resend notification service throws at boot if this is empty. Any non-empty
# placeholder boots the server locally; real e-mails need a real key.
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=

# --- Optional -------------------------------------------------------------
# Leave empty locally: in-memory event bus/cache (scheduled jobs disabled).
REDIS_URL=
LOG_LEVEL=info
MEDUSA_REGION=
OPEN_BROWSER=false

# PayPal (leave empty to disable)
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_AUTH_WEBHOOK_ID=

# S3 file storage (leave empty to use local ./uploads)
S3_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CACHE_CONTROL=
